# ==============================================================================
# Mau bien moi truong WebBD (copy thanh file .env truoc khi chay Docker / VPS)
# Luu y: Khong bao gio commit file .env chua mat khau that len Git!
# ==============================================================================

# --- Database MySQL 8.0 ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=WebBD_db
MYSQL_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# --- Backend Spring Boot ---
# Khi chay Docker Compose, DB_URL se tu dong tro toi service "mysqldb"
# Khi chay IntelliJ local (khong dung Docker cho BE), application.properties mac dinh tro localhost:3306
JWT_SECRET=thay-doi-chuoi-bi-mat-it-nhat-32-ky-tu-truoc-khi-deploy-vps
JWT_EXPIRATION_MS=86400000
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Nhieu origin ngan cach bang dau phay, vd: https://shop.domain.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Next.js (nhung luc build Docker image) ---
# Chay local Docker: http://localhost:8080
# Chay VPS sau Nginx cung domain HTTPS: de rong (NEXT_PUBLIC_API_URL=) hoac https://domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080
